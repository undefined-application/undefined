# Drizzle
DATABASE_URL=local.db
# Clones and scan artefacts (gitignored)
DATA_DIR=data

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
# Callback URL: <ORIGIN>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# LLM (Gonka brokers, OpenAI-compatible) — plan §4.1 / §6
# Keys per broker, comma-separated (one per team member). Base URLs and model ids: src/lib/server/llm/brokers.ts
# Chain: broker order → each key → tier model, other tier model, fallback models. Bad key / no credit → next key.
LLM_KEYS_GONKA_API=""
LLM_KEYS_GONKAROUTER=""
LLM_KEYS_GONKA24=""
LLM_KEYS_HYPERFUSION=""
# Hyperfusion first: DeepSeek answered in ~3 s there, 21-42 s (or timed out) on the Gonka brokers (measured 2026-09-26).
LLM_BROKER_ORDER="hyperfusion,gonka-api,gonkarouter,gonka24"
LLM_MODEL_FAST="MiniMaxAI/MiniMax-M2.7"
LLM_MODEL_STRONG="deepseek-ai/DeepSeek-V4-Flash-0731"
LLM_MODEL_FALLBACK="zai-org/GLM-5.3-Flash"
# Optional extra OpenAI-compatible endpoint, tried first (standard model ids)
LLM_BASE_URL=""
LLM_API_KEY=""
